# Required: Google Gemini API key for AI-powered content analysis
GEMINI_API_KEY=

# Required: Google Custom Search API credentials for company verification
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Required (if URL scanning enabled): VirusTotal API key for URL scanning
VTotal_API_KEY=

# Optional: URLScan.io API key (additional URL scanner)
URLSCAN_API_KEY=

# URL Scanning Master Switch: Set to TRUE to enable all URL scanning (VirusTotal and URLScan.io)
# When FALSE, URL analysis is completely disabled
URLSCAN_ENABLED=FALSE

# Required: Main AI prompt for email analysis
MAIN_PROMPT="Please identify the claimed organization (or UNKNOWN if none), and summarize what the sender wants in one short sentence. Evaluate whether the email looks authentic using plain, simple, and unambiguous language. Keep all reasons very short and concise (under 15 words). Provide realisticReason explaining the presentation and branding, and provide overallAssessment giving a general, short and concise safety evaluation for the whole email (under 15 words), rather than focusing on a single category."

# Optional: Path to custom shared hosting domains list (defaults to shared_hosting_domains.txt)
# SHARED_HOSTING_DOMAINS_FILE=shared_hosting_domains.txt

# Beta Feature: Relaxed VirusTotal suspicious threshold.
# Set to TRUE to require >=1 malicious engine or >=2 suspicious engines to flag a link
# (avoids false positives from single rogue engines like ArcSight).
# Set to FALSE (default) to flag links if any engine flags as malicious or suspicious.
BETA_VT_THRESHOLD=FALSE
